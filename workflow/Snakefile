        + [f"11_calib_flood_progression__calib_r{r}.mp4" for r in CALIB_ROUNDS])
      if ANALYSIS else []),
]

# Basin-level, scenario-independent: skeleton, spin-up (run_spinup, mean river
# discharge + calm sea) and its sanity checks.
_BUILD_OUTPUTS_BASIN = [
    expand(results_path("{basin_id}/sfincs_skeleton/sfincs.inp"), basin_id=BASINS),
    expand(results_path("{basin_id}/sfincs_skeleton/sfincs.weir"), basin_id=BASINS),
    expand(results_path("{basin_id}/sfincs_skeleton/{basin_id}_coastal_protection_weir.gpkg"), basin_id=BASINS),
    expand(results_path("{basin_id}/sfincs_skeleton/sfincs_subgrid.nc"), basin_id=BASINS),
    expand(figure_path("{name}"), basin_id=BASINS, name=[
        "10_build_grid.png", "11_build_elevation.png", "12_build_mask.png",
        "13_build_roughness.png", "14_build_zsini.png", "15_build_coastal_weir.png",
    ]),
    *(expand(results_path("{basin_id}/spin_up/" + RST_FNAME), basin_id=BASINS)
      + expand(results_path("{basin_id}/spin_up/sfincs_map.nc"), basin_id=BASINS)
      + expand(figure_path("20_forcing_timeseries__spinup.png"), basin_id=BASINS)
      + expand(figure_path("40_run_max_flood_depth__spinup.png"), basin_id=BASINS)
      + (expand(analysis_figure_path("{name}"), basin_id=BASINS, name=[
          "13_spinup_water_level.png", "13_spinup_inundation_ratio.png", "13_spinup_flood_progression.mp4",
        ]) if ANALYSIS else [])
      if config["sfincs"]["spinup"]["enabled"] else []),
]

# Per-scenario: build_sfincs, run_event, compute_flood_metrics.
_BUILD_OUTPUTS_SCENARIO = [
    expand(results_path("{basin_id}/runs/{scenario}/sfincs/sfincs.inp"), basin_id=BASINS, scenario=SCENARIOS),
    expand(results_path("{basin_id}/runs/{scenario}/sfincs/sfincs_map.nc"), basin_id=BASINS, scenario=SCENARIOS),
    expand(figure_path("20_forcing_timeseries__{scenario}.png"), basin_id=BASINS, scenario=SCENARIOS),
    expand(figure_path("40_run_max_flood_depth__{scenario}.png"), basin_id=BASINS, scenario=SCENARIOS),
    *((expand(analysis_figure_path("15_run_inundation_ratio__{scenario}.png"), basin_id=BASINS, scenario=SCENARIOS)
       + expand(figure_path("50_run_flood_progression__{scenario}.mp4"), basin_id=BASINS, scenario=SCENARIOS)
       + expand(results_path("{basin_id}/runs/{scenario}/visuals/flood_timeseries.csv"), basin_id=BASINS, scenario=SCENARIOS))
      if ANALYSIS else []),
    expand(results_path("{basin_id}/runs/{scenario}/visuals/max_flood_depth.tif"), basin_id=BASINS, scenario=SCENARIOS),
    expand(results_path("{basin_id}/runs/{scenario}/metrics/flood_metrics.csv"), basin_id=BASINS, scenario=SCENARIOS),
]

_BUILD_OUTPUTS = _BUILD_OUTPUTS_BASIN + _BUILD_OUTPUTS_SCENARIO


# Every adaptation output is listed so each is directly targetable.
_ADAPT_OUTPUTS = []
if "pre" in METHODS:
    _ADAPT_OUTPUTS += (
        expand(results_path("{basin_id}/runs/{scenario}/adaptation/pre/{strategy}/sfincs/sfincs_map.nc"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + expand(figure_path("20_forcing_timeseries__{scenario}__pre_{strategy}.png"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + expand(figure_path("40_run_max_flood_depth__{scenario}__pre_{strategy}.png"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + expand(figure_path("62_adapt_inundation_ratio__{scenario}__pre_{strategy}.png"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + ((expand(figure_path("63_adapt_flood_progression__{scenario}__pre_{strategy}.mp4"),
                   basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
            + expand(results_path("{basin_id}/runs/{scenario}/adaptation/pre/{strategy}/flood_timeseries.csv"),
                   basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES))
           if ANALYSIS else [])
        + expand(results_path("{basin_id}/runs/{scenario}/adaptation/pre/{strategy}/max_flood_depth.tif"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + expand(results_path("{basin_id}/runs/{scenario}/adaptation/pre/{strategy}/flood_metrics.csv"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
    )
if "post" in METHODS:
    _ADAPT_OUTPUTS += (
        expand(results_path("{basin_id}/runs/{scenario}/adaptation/post/{strategy}/max_flood_depth.tif"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + expand(results_path("{basin_id}/runs/{scenario}/adaptation/post/{strategy}/flood_metrics.csv"),
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
        + expand(figure_path("{name}__{scenario}__post_{strategy}.png"),
               name=["40_run_max_flood_depth", "62_adapt_inundation_ratio"],
               basin_id=BASINS, scenario=SCENARIOS, strategy=STRATEGIES)
    )
if {"pre", "post"} <= set(METHODS):
    _ADAPT_OUTPUTS += expand(
        results_path("{basin_id}/runs/metrics_comparison.csv"),
        basin_id=BASINS)
# Adaptation runs restart from the spin-up (restart file, spin-up map).
if STRATEGIES and not config["sfincs"]["spinup"]["enabled"]:
    raise ValueError(
        "adaptation (target_strategies) needs the spin-up: set "
        "sfincs.spinup.enabled: true in the config, or run without target_strategies"
    )


rule adapt:
    """
    Run adaptation strategies against built baseline scenario runs.

    Requires rule `build` for the same basin/scenario and --config
    target_strategies=[...] (no default); target_method defaults to pre and post.

    Usage:  snakemake adapt --cores N --config target_strategies="['advance_1']"
    """
    input: _ADAPT_OUTPUTS


# ── Named partial-pipeline targets ──

rule preprocess:
    """
    Run only the preprocessing pipeline (rules 01–11).

    Usage:  snakemake preprocess --cores N
    """
    input: _PREPROCESS_OUTPUTS


rule build:
    """
    Build and run SFINCS: skeleton, forcing, spin-up, event runs and metrics.

    Preprocessing outputs must exist. Skeleton and spin-up run once per basin.

    Usage:  snakemake build --cores N
    """
    input: _BUILD_OUTPUTS


rule all:
    """
    Run preprocess + build; the target of a bare `snakemake`.

    Usage:  snakemake --cores N
    """
    default_target: True
    input: _PREPROCESS_OUTPUTS + _BUILD_OUTPUTS
