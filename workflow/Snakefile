# Snakemake entry point: includes every rule and defines the named targets.

from snakemake.utils import min_version
min_version("7.0")

configfile: "./config/config.yml"

include: "rules/00_common.smk"

# Rules, numbered in the order they run; 07a-c (storm tide) feed 07d (boundary
# forcings), 12b/12c and 13b branch off 12 and 13.
include: "rules/01_domain.smk"
include: "rules/02_river_network.smk"
include: "rules/03_protection_levels.smk"
include: "rules/04_sfincs_grid.smk"
include: "rules/05_landuse_source.smk"
include: "rules/06_elevation.smk"
include: "rules/07a_storm_tide_hydrographs.smk"
include: "rules/07d_boundary_forcings.smk"
include: "rules/08_clean_river_network.smk"
include: "rules/09_land_surface.smk"
include: "rules/10_river_surface.smk"
include: "rules/11_depth_estimation_modelled.smk"
include: "rules/12a_build_sfincs_skeleton.smk"
include: "rules/12b_land_bed_level.smk"
include: "rules/12c_build_adaptation_lines.smk"
include: "rules/13a_run_spinup.smk"
include: "rules/13b_sanity_checks.smk"
