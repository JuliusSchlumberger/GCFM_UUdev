# Snakefile

from snakemake.utils import min_version
min_version("7.0")

# ---- Configuration ----
configfile: "./config/config.yml"

# ---- Shared setup (catalogue helpers, wildcard constraints, etc.) ----
include: "rules/00_common.smk"

# ---- Rules ----
# Included in true DAG/topological order -- see each rule's own docstring
# for its actual predecessors/successors. Rule enforce_river_monotonicity
# (09, conditioning) depends only on rule 08's cleaned network
# (topology/width, no depth), so it runs before both depth-estimation
# rules and produces the conditioned elevation they both consume. Rules
# empirical_depth_estimation and modelled_depth_estimation (both numbered
# 10) are sibling ALTERNATIVES selected by river_processing.depth_method --
# exactly one ever runs, both writing the same unified
# river_network_depth_estimated.gpkg AND the same unified burned-river-DEM
# filenames (river_burned_dem.tif, river_burned_dem_sfincs_grid.tif) --
# not a sequential chain. Each burns its own channel directly (never
# hydromt's own gdf_zb/burn_river_rect).
include: "rules/01_separate_deltas.smk"
include: "rules/02_modeldomain.smk"
include: "rules/03_land_polygons.smk"
include: "rules/04_protection_levels.smk"
include: "rules/05_static_terrain_data.smk"
include: "rules/06_river_network.smk"
include: "rules/07_boundary_forcings.smk"
include: "rules/08_clean_river_network.smk"
include: "rules/08b_optimize_grid_resolution.smk"
include: "rules/08c_build_sfincs_grid.smk"
include: "rules/09_condition_elevation.smk"
include: "rules/10_depth_estimation_empirical.smk"
include: "rules/10_depth_estimation_modelled.smk"
include: "rules/11_testing.smk"
include: "rules/13_build_sfincs.smk"
include: "rules/14_run_spinup.smk"
include: "rules/15_sanity_checks.smk"
include: "rules/16_run_event.smk"
include: "rules/17_flood_metrics.smk"

