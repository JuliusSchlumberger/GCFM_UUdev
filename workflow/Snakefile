include: "rules/18_adapt_compare.smk"
include: "rules/19_analysis_figures.smk"

# ── Output lists for the named targets ──

_PREPROCESS_OUTPUTS = [
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_delta_polygon.gpkg"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/domain_bbox.json"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_domain.gpkg"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_landuse_source.tif"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_land_polygons.gpkg"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/protection_levels.json"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_elevation_merged.tif"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_landuse.tif"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_roughness.tif"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_river_network.gpkg"), basin_id=BASINS),
    *(expand(results_path("{basin_id}/preprocessing_inputs/forcing/storm_tide_hydrographs.nc"), basin_id=BASINS)
      + (expand(analysis_figure_path("07_forcing_storm_tide_shapes.png"), basin_id=BASINS) if ANALYSIS else [])
      if config["boundary_forcings"]["surge"]["hydrograph"]["enabled"] else []),
    expand(results_path("{basin_id}/preprocessing_inputs/forcing/surge_forcing.nc"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/forcing/river_forcing.nc"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/forcing/glofas_clip.nc"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_river_network_clean.gpkg"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_sfincs_grid.json"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_elevation_conditioned.tif"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_elevation_conditioned_sfincs_grid.tif"), basin_id=BASINS),
    # Rule modelled_depth_estimation (11)
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_river_network_depth_estimated.gpkg"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_river_burned_subgrid.tif"), basin_id=BASINS),
    expand(results_path("{basin_id}/preprocessing_inputs/domain/{basin_id}_river_burned_dem_sfincs_grid.tif"), basin_id=BASINS),
